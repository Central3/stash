<button data-open-modal="#newfile-dialog">New File</button>

<dialog id="newfile-dialog">
  <form
    action="<%= locals.folder?.id ? `/folders/${folder.id}/files` : '/files' %>"
    method="POST"
    enctype="multipart/form-data"
  >
    <label>
      Choose file to upload
      <input type="file" name="file" required />
    </label>
    <div>
      <button type="submit">Upload</button>
      <button type="button" data-close-modal>Close</button>
    </div>
  </form>
</dialog>