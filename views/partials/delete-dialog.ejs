<button data-open-modal="#delete-dialog">Delete</button>

<dialog class="modal" id="delete-dialog">
    Confirm Delete
    <form class="modal__form" action="/folders/<%= folder.id %>/delete" method="POST">
        <label>
            <input type="checkbox" name="keep_files" id="keep_files"> Keep Files
        </label>
        
        <div class="modal__actions">
           <button>Yes</button>
            <button type="button" data-close-modal>No</button> 
        </div>
      </form>
</dialog>