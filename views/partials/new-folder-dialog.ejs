<button data-open-modal="#newfolder-dialog">New Folder</button>

<dialog class="modal" id="newfolder-dialog">
  <form class="modal__form" action="<%= locals.folder?.id ? `/folders/${folder.id}` : '/folders' %>" method="POST">
    <label> Title: <input type="text" name="title" id="form_title" /> </label>
    <div class="modal__actions">
      <button type="submit">Create Folder</button>
    <button type="button" data-close-modal>Cancel</button>
    </div>
  </form>
</dialog>